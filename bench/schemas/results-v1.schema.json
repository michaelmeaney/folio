{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/benchmark/results-v1.schema.json",
  "title": "Folio benchmark results v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestSha256",
    "runId",
    "completedAt",
    "benchmarkSha256",
    "controls",
    "comparison",
    "results",
    "cancelled"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestSha256": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "benchmarkSha256": {
      "type": "string"
    },
    "controls": {
      "type": "object"
    },
    "comparison": {
      "type": "object"
    },
    "cancelled": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "repetition",
          "status",
          "durationSeconds",
          "execution",
          "evaluations"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
          },
          "repetition": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "error",
              "timeout",
              "skipped",
              "unverified"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "score": {
            "type": "number"
          },
          "violations": {
            "type": "array"
          },
          "artifacts": {
            "type": "array"
          },
          "execution": {
            "type": "object"
          },
          "review": {
            "type": "object"
          },
          "evaluations": {
            "type": "object"
          },
          "diagnostic": {
            "type": "string"
          },
          "evaluatorProcesses": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
