{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelmeaney/folio/schemas/folio-0.1.0.schema.json",
  "title": "Folio semantic presentation contracts 0.1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/design-system"
    },
    {
      "$ref": "#/$defs/presentation-profile"
    },
    {
      "$ref": "#/$defs/component"
    },
    {
      "$ref": "#/$defs/renderer-binding"
    },
    {
      "$ref": "#/$defs/pattern"
    },
    {
      "$ref": "#/$defs/archetype"
    },
    {
      "$ref": "#/$defs/composition"
    },
    {
      "$ref": "#/$defs/scene"
    },
    {
      "$ref": "#/$defs/visual-specification"
    },
    {
      "$ref": "#/$defs/execution-result"
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "token-ref": {
      "type": "object",
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "magnitude": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/token-ref"
        }
      ]
    },
    "frame": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": [
        "accepts",
        "minItems",
        "maxItems"
      ],
      "properties": {
        "accepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "contentFrom": {
          "type": "object",
          "required": [
            "property"
          ],
          "properties": {
            "property": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "design-system": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "version",
        "tokenFormat",
        "resources"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "design-system"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string"
        },
        "tokenFormat": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "dtcg"
            },
            "version": {
              "const": "2025.10"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "required": [
            "tokens",
            "presentation"
          ],
          "properties": {
            "design": {
              "$ref": "#/$defs/path"
            },
            "tokens": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "presentation": {
              "$ref": "#/$defs/path"
            },
            "components": {
              "$ref": "#/$defs/path"
            },
            "patterns": {
              "$ref": "#/$defs/path"
            },
            "archetypes": {
              "$ref": "#/$defs/path"
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "package",
              "version",
              "sha256"
            ],
            "properties": {
              "package": {
                "type": "string"
              },
              "version": {
                "$ref": "#/$defs/semver"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "presentation-profile": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "canvas",
        "units"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "presentation-profile"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "canvas": {
          "type": "object",
          "required": [
            "width",
            "height",
            "unit"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "px"
            }
          },
          "additionalProperties": false
        },
        "units": {
          "type": "object",
          "required": [
            "pixelsPerInch",
            "pointsPerInch",
            "rootFontSizePx"
          ],
          "properties": {
            "pixelsPerInch": {
              "const": 96
            },
            "pointsPerInch": {
              "const": 72
            },
            "rootFontSizePx": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "grid": {
          "type": "object"
        },
        "safeArea": {
          "type": "object",
          "required": [
            "left",
            "right",
            "top",
            "bottom"
          ],
          "properties": {
            "left": {
              "$ref": "#/$defs/magnitude"
            },
            "right": {
              "$ref": "#/$defs/magnitude"
            },
            "top": {
              "$ref": "#/$defs/magnitude"
            },
            "bottom": {
              "$ref": "#/$defs/magnitude"
            }
          },
          "additionalProperties": false
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "atmosphere": {
          "type": "object"
        },
        "textOverflow": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "version",
        "name",
        "description",
        "propertiesSchema",
        "slots",
        "anchors",
        "bindings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "component"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "propertiesSchema": {
          "type": "object"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/slot"
          }
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "additionalProperties": false
    },
    "renderer-binding": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "version",
        "component",
        "componentVersion",
        "target",
        "representation",
        "source",
        "anchors",
        "capabilities"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "renderer-binding"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "componentVersion": {
          "$ref": "#/$defs/semver"
        },
        "target": {
          "const": "powerpoint"
        },
        "representation": {
          "enum": [
            "native-group",
            "native-shape",
            "svg",
            "hybrid",
            "raster"
          ]
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "editText",
            "editGeometry",
            "recolour",
            "resize",
            "attachConnectors",
            "editData"
          ],
          "properties": {
            "editText": {
              "type": "boolean"
            },
            "editGeometry": {
              "type": "boolean"
            },
            "recolour": {
              "type": "boolean"
            },
            "resize": {
              "enum": [
                "none",
                "uniform",
                "free"
              ]
            },
            "attachConnectors": {
              "type": "boolean"
            },
            "editData": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "version",
        "name",
        "slots",
        "relationships",
        "layout"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "pattern"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/slot"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "type",
              "direction"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "forward",
                  "backward",
                  "bidirectional"
                ]
              },
              "when": {
                "type": "object",
                "required": [
                  "slotPresent"
                ],
                "properties": {
                  "slotPresent": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "object",
          "required": [
            "strategy",
            "constraints"
          ],
          "properties": {
            "strategy": {
              "const": "constraint"
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "op",
                  "strength"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "row",
                      "column",
                      "align",
                      "gap",
                      "below",
                      "inside",
                      "non-overlap",
                      "preserve-frame"
                    ]
                  },
                  "strength": {
                    "enum": [
                      "required",
                      "preferred"
                    ]
                  },
                  "slots": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "subject": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/magnitude"
                  },
                  "when": {
                    "type": "object",
                    "required": [
                      "slotPresent"
                    ],
                    "properties": {
                      "slotPresent": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "overflow": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "archetype": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "version",
        "name",
        "regions",
        "layout"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "archetype"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "regions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/slot"
          }
        },
        "layout": {
          "type": "object"
        },
        "overflow": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "bindings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "composition"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "pattern": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "version": {
              "$ref": "#/$defs/semver"
            }
          },
          "additionalProperties": false
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "component",
              "properties"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "component": {
                "$ref": "#/$defs/id"
              },
              "properties": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "canvas",
        "objects",
        "readingOrder"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "scene"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "compositionRef": {
          "$ref": "#/$defs/path"
        },
        "canvas": {
          "type": "object",
          "required": [
            "width",
            "height",
            "unit"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "px"
            }
          },
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "frame",
              "layer"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "semanticRef": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "enum": [
                  "shape",
                  "text",
                  "line",
                  "connector",
                  "image",
                  "vector",
                  "group"
                ]
              },
              "frame": {
                "$ref": "#/$defs/frame"
              },
              "layer": {
                "type": "string"
              },
              "contentRef": {
                "$ref": "#/$defs/path"
              },
              "assetRef": {
                "$ref": "#/$defs/path"
              },
              "style": {
                "type": "object"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "readingOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    },
    "visual-specification": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "source",
        "authority",
        "observations"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "visual-specification"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "authority": {
          "enum": [
            "reference",
            "generated-candidate"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "execution-result": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "runId",
        "status",
        "artefacts",
        "budget"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "execution-result"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "accepted",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "artefacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "budget": {
          "type": "object",
          "required": [
            "repairRoundsUsed",
            "repairRoundsLimit"
          ],
          "properties": {
            "repairRoundsUsed": {
              "type": "integer",
              "minimum": 0
            },
            "repairRoundsLimit": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "stopReason": {
          "type": "string"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
