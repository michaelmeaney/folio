{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelmeaney/folio/schemas/folio-0.2.0.schema.json",
  "title": "Folio semantic presentation contracts 0.2.0",
  "oneOf": [
    {
      "$ref": "#/$defs/visual-specification"
    },
    {
      "$ref": "#/$defs/scene"
    },
    {
      "$ref": "#/$defs/execution-result"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "canvas",
        "objects",
        "readingOrder",
        "slideIndex"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.2.0"
        },
        "kind": {
          "const": "scene"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "compositionRef": {
          "$ref": "#/$defs/path"
        },
        "canvas": {
          "type": "object",
          "required": [
            "width",
            "height",
            "unit"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "px"
            }
          },
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "frame",
              "layer"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "semanticRef": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "enum": [
                  "shape",
                  "text",
                  "line",
                  "connector",
                  "image",
                  "vector",
                  "group"
                ]
              },
              "frame": {
                "$ref": "#/$defs/frame"
              },
              "layer": {
                "type": "string"
              },
              "contentRef": {
                "$ref": "#/$defs/path"
              },
              "assetRef": {
                "$ref": "#/$defs/path"
              },
              "style": {
                "type": "object"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "decorative": {
                "type": "boolean"
              },
              "relationship": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "type",
                  "directed",
                  "label"
                ],
                "properties": {
                  "from": {
                    "$ref": "#/$defs/id"
                  },
                  "to": {
                    "$ref": "#/$defs/id"
                  },
                  "type": {
                    "enum": [
                      "technical",
                      "illustrative",
                      "annotation",
                      "contains",
                      "overlaps",
                      "aligned-with"
                    ]
                  },
                  "directed": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "editing": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "text",
                    "shapeGeometry",
                    "resizeVector",
                    "attachConnectors"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "readingOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 1
        },
        "preservation": {
          "type": "object",
          "required": [
            "visualSpecificationRef",
            "baselineSha256",
            "regions",
            "relationships",
            "primaryRegion"
          ],
          "properties": {
            "visualSpecificationRef": {
              "$ref": "#/$defs/path"
            },
            "baselineSha256": {
              "$ref": "#/$defs/digest"
            },
            "regions": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "required": [
                  "regionId",
                  "objectIds"
                ],
                "properties": {
                  "regionId": {
                    "$ref": "#/$defs/id"
                  },
                  "objectIds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "relationships": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "required": [
                  "relationshipId",
                  "objectIds"
                ],
                "properties": {
                  "relationshipId": {
                    "$ref": "#/$defs/id"
                  },
                  "objectIds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "primaryRegion": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "visual-specification": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "source",
        "authority",
        "sourceSha256",
        "sourceDimensions",
        "sourceSlideCount",
        "slideIndex",
        "intent",
        "regions",
        "relationships",
        "hierarchy",
        "deviations"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.2.0"
        },
        "kind": {
          "const": "visual-specification"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "authority": {
          "enum": [
            "reference",
            "generated-candidate"
          ]
        },
        "sourceSha256": {
          "$ref": "#/$defs/digest"
        },
        "sourceDimensions": {
          "type": "object",
          "required": [
            "width",
            "height",
            "unit"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "px"
            }
          },
          "additionalProperties": false
        },
        "sourceSlideCount": {
          "type": "integer",
          "minimum": 1
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 1
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "relationships": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "hierarchy": {
          "type": "object",
          "required": [
            "primaryRegion",
            "readingOrder"
          ],
          "properties": {
            "primaryRegion": {
              "$ref": "#/$defs/id"
            },
            "readingOrder": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "deviations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/deviation"
          }
        }
      },
      "additionalProperties": false
    },
    "execution-result": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "runId",
        "status",
        "artefacts",
        "budget",
        "intent",
        "scenes",
        "provenance",
        "differences",
        "gates",
        "editingChecks",
        "unresolved"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.2.0"
        },
        "kind": {
          "const": "execution-result"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "accepted",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "artefacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "budget": {
          "type": "object",
          "required": [
            "repairRoundsUsed",
            "repairRoundsLimit"
          ],
          "properties": {
            "repairRoundsUsed": {
              "type": "integer",
              "minimum": 0
            },
            "repairRoundsLimit": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "stopReason": {
          "type": "string"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "scenes": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "folioCommit",
            "designSystemRevision",
            "renderer",
            "sources"
          ],
          "properties": {
            "folioCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "designSystemRevision": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "renderer": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 0,
              "items": {
                "$ref": "#/$defs/evidence"
              }
            }
          },
          "additionalProperties": false
        },
        "differences": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "specificationRef",
              "deviationId",
              "description"
            ],
            "properties": {
              "specificationRef": {
                "$ref": "#/$defs/path"
              },
              "deviationId": {
                "$ref": "#/$defs/id"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "gates": {
          "type": "object",
          "required": [
            "content",
            "composition",
            "treatment",
            "artefact"
          ],
          "properties": {
            "content": {
              "type": "object",
              "required": [
                "status",
                "summary",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unverified"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "composition": {
              "type": "object",
              "required": [
                "status",
                "summary",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unverified"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "treatment": {
              "type": "object",
              "required": [
                "status",
                "summary",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unverified"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "artefact": {
              "type": "object",
              "required": [
                "status",
                "summary",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unverified"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "editingChecks": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "operation",
              "status",
              "application",
              "version",
              "evidence"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "text",
                  "shapeGeometry",
                  "resizeVector",
                  "attachConnectors"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unverified"
                ]
              },
              "application": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "pass"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "scenes": {
                "minItems": 1
              },
              "artefacts": {
                "required": [
                  "pptx",
                  "render"
                ]
              },
              "unresolved": {
                "maxItems": 0
              },
              "gates": {
                "properties": {
                  "content": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      },
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  },
                  "composition": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      },
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  },
                  "treatment": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      },
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  },
                  "artefact": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      },
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  }
                }
              },
              "editingChecks": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "pass"
                    },
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          },
          "else": {
            "required": [
              "stopReason"
            ]
          }
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": [
        "operation",
        "mode",
        "permissions"
      ],
      "properties": {
        "operation": {
          "enum": [
            "convert",
            "restyle",
            "redesign",
            "create"
          ]
        },
        "mode": {
          "enum": [
            "quick",
            "guided",
            "governed"
          ]
        },
        "designSystem": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "object",
          "required": [
            "rewriteCopy",
            "splitSlides",
            "replacePrimaryVisual",
            "recompose",
            "consolidate",
            "omitContent"
          ],
          "properties": {
            "rewriteCopy": {
              "type": "boolean"
            },
            "splitSlides": {
              "type": "boolean"
            },
            "replacePrimaryVisual": {
              "type": "boolean"
            },
            "recompose": {
              "type": "boolean"
            },
            "consolidate": {
              "type": "boolean"
            },
            "omitContent": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "authorizationRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "governed"
              }
            }
          },
          "then": {
            "required": [
              "designSystem"
            ]
          },
          "else": {
            "not": {
              "required": [
                "designSystem"
              ]
            }
          }
        }
      ]
    },
    "normalised-frame": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "tolerance": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "role",
        "frame",
        "tolerance",
        "text",
        "confidence",
        "ambiguity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "title",
            "primary-visual",
            "supporting-visual",
            "text",
            "annotation",
            "whitespace"
          ]
        },
        "frame": {
          "$ref": "#/$defs/normalised-frame"
        },
        "tolerance": {
          "$ref": "#/$defs/tolerance"
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "type",
        "directed",
        "label",
        "confidence",
        "ambiguity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "technical",
            "illustrative",
            "annotation",
            "contains",
            "overlaps",
            "aligned-with"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "deviation": {
      "type": "object",
      "required": [
        "id",
        "permission",
        "sourceIds",
        "reason",
        "authorizationRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "permission": {
          "enum": [
            "rewriteCopy",
            "splitSlides",
            "replacePrimaryVisual",
            "recompose",
            "consolidate",
