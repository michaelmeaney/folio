{
  "schemaVersion": "0.1.0",
  "kind": "presentation-profile",
  "id": "lumen.wide",
  "canvas": {
    "width": 1279.968,
    "height": 720.0,
    "unit": "px"
  },
  "units": {
    "pixelsPerInch": 96,
    "pointsPerInch": 72,
    "rootFontSizePx": 16
  },
  "grid": {
    "columns": 12,
    "gutter": {
      "token": "spacing.gutter"
    }
  },
  "safeArea": {
    "left": {
      "token": "spacing.safeArea.left"
    },
    "right": {
      "token": "spacing.safeArea.right"
    },
    "top": {
      "token": "spacing.safeArea.top"
    },
    "bottom": {
      "token": "spacing.safeArea.bottom"
    }
  },
  "layers": {
    "canvas": 0,
    "atmosphere": 10,
    "backgroundObject": 20,
    "foregroundVisual": 50,
    "foregroundText": 60,
    "annotation": 70
  },
  "textOverflow": {
    "allowTruncation": false,
    "allowUnapprovedRewrite": false
  },
  "extensions": {
    "io.github.michaelmeaney.folio": {
      "legacyVersion": "0.1.0",
      "legacyCanvasRatio": "16:9"
    }
  },
  "atmosphere": {
    "opacity": [
      0.08,
      0.24
    ],
    "blurPx": [
      80,
      160
    ],
    "scaleSlideWidth": [
      0.2,
      0.45
    ],
    "maxPerSlide": 3
  }
}
